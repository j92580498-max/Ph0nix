--- a/hw/arm/db2010-device.c
+++ b/hw/arm/db2010-device.c
@@ -98,6 +98,8 @@ typedef struct DB2010DeviceBody {
     void *timing_opaque;
     DeviceState *dependencies[2];
     unsigned dependency_count;
+    uint64_t reschedules, unchanged_deadlines, service_calls;
+    uint64_t schedule_samples, schedule_ns, service_samples, service_ns;
 } DB2010DeviceBody;
 
 typedef struct DB2010Controller {
@@ -266,6 +268,12 @@ static void initialize_body(Object *obj, DB2010DeviceBody *b,
                             const DB2010DeviceSpec *spec)
 {
     b->spec = spec; b->model = g_malloc0(spec->size);
+    if (spec->id == DBDEV_DISPLAY) {
+        /* Checkpoints contain an empty display even when PDI is inactive.
+         * Its cache and capture queues must exist before restore; an inactive
+         * model intentionally skips the ordinary device reset callback. */
+        db2010_display_capture_reset(b->model);
+    }
     if (spec->id == DBDEV_SYSCON) {
         DB2010Syscon *s = b->model;
         s->cpu_clock = qdev_init_clock_out(DEVICE(obj), "cpu");
@@ -533,22 +541,55 @@ void db2010_device_cancel_timer(DeviceState *dev)
 void db2010_device_reschedule(DeviceState *dev)
 {
     DB2010DeviceBody *b = body_of(OBJECT(dev));
+    bool sample = (++b->reschedules & 255) == 0;
+    int64_t started = sample ? get_clock() : 0;
     if (b->timer) {
         int64_t due = b->deadline(b->timing_opaque);
-        if (due < 0) { timer_del(b->timer); }
+        if ((due < 0 && !timer_pending(b->timer)) ||
+            (due >= 0 && timer_expire_time_ns(b->timer) == due)) {
+            /* Repeated register reads often leave the hardware deadline
+             * unchanged. Preserve the pending timer instead of taking its
+             * list lock, removing/reinserting it and notifying the host loop.
+             * Check the actual timer, so firing/reset/restore cannot leave
+             * stale cached scheduling state. Dependencies still reschedule. */
+            b->unchanged_deadlines++;
+        } else if (due < 0) { timer_del(b->timer); }
         else { timer_mod_ns(b->timer, due); }
     }
     for (unsigned i = 0; i < b->dependency_count; i++) {
         db2010_device_reschedule(b->dependencies[i]);
     }
+    if (sample) { b->schedule_samples++; b->schedule_ns += MAX(get_clock() - started, 0); }
 }
 static void service_timer(void *opaque)
 {
     DeviceState *dev = opaque;
     DB2010DeviceBody *b = body_of(OBJECT(dev));
+    bool sample = (++b->service_calls & 255) == 0;
+    int64_t started = sample ? get_clock() : 0;
     b->service(b->timing_opaque);
+    if (sample) { b->service_samples++; b->service_ns += MAX(get_clock() - started, 0); }
     db2010_device_reschedule(dev);
 }
+
+const char *db2010_device_name(DB2010DeviceId id)
+{
+    assert(id < DBDEV_COUNT);
+    return devices[id].name;
+}
+QDict *db2010_device_profile(DeviceState *dev)
+{
+    DB2010DeviceBody *b = body_of(OBJECT(dev));
+    QDict *profile = qdict_new();
+    qdict_put_int(profile, "reschedules", b->reschedules);
+    qdict_put_int(profile, "unchanged_deadlines", b->unchanged_deadlines);
+    qdict_put_int(profile, "service_calls", b->service_calls);
+    qdict_put_int(profile, "schedule_samples", b->schedule_samples);
+    qdict_put_int(profile, "schedule_ns", b->schedule_ns);
+    qdict_put_int(profile, "service_samples", b->service_samples);
+    qdict_put_int(profile, "service_ns", b->service_ns);
+    return profile;
+}
 void db2010_device_timing(DeviceState *dev, DB2010DeadlineFn deadline,
                           DB2010ServiceFn service, void *opaque)
 {
