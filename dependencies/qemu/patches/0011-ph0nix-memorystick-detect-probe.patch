diff --git a/hw/arm/db2010-memorystick.c b/hw/arm/db2010-memorystick.c
new file mode 100644
index 0000000000000000000000000000000000000000..c4390d31a6158281a01ee2805e99c4e3e7890166
--- /dev/null
+++ b/hw/arm/db2010-memorystick.c
@@ -0,0 +1,399 @@
+/* Memory Stick PRO card and DB2010 programmed I/O controller.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/units.h"
+#include <glib/gstdio.h>
+#ifdef _WIN32
+#include <io.h>
+#else
+#include <sys/file.h>
+#endif
+#include "db2010-memorystick.h"
+
+/* Controller status is distinct from the card's GET_INT response. */
+enum { MS_COMPLETE = 0x80, MS_EVENT = 0x40, MS_ERROR = 0x02 };
+enum { CARD_CED = 0x80, CARD_ERR = 0x40, CARD_BREQ = 0x20, CARD_NAK = 1 };
+enum { CARD_READ = 0x20, CARD_WRITE = 0x21, CARD_ATTR = 0x24, CARD_STOP = 0x25 };
+#define ATTR_SECTORS 64
+#define BLOCK_SECTORS 64
+#define MAX_FIFO 16
+
+static bool lock_image(int fd)
+{
+#ifdef _WIN32
+    OVERLAPPED range = {0};
+    return LockFileEx((HANDLE)_get_osfhandle(fd),
+                      LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY,
+                      0, MAXDWORD, MAXDWORD, &range);
+#else
+    return flock(fd, LOCK_EX | LOCK_NB) == 0;
+#endif
+}
+
+bool dbms_open(DB2010MemoryStick *ms, const char *path, Error **errp)
+{
+    if (ms->image) {
+        error_setg(errp, "A Memory Stick image is already attached");
+        return false;
+    }
+    int flags = O_RDWR;
+#ifdef _WIN32
+    flags |= O_BINARY;
+#else
+    flags |= O_NONBLOCK;
+#endif
+    int fd = g_open(path, flags, 0);
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "Opening Memory Stick image");
+        return false;
+    }
+    struct stat st;
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 16 * MiB ||
+        st.st_size > GiB || st.st_size % (BLOCK_SECTORS * DBMS_SECTOR)) {
+        error_setg(errp, "Memory Stick image must be a regular raw image of 16 MiB to 1 GiB, aligned to 32 KiB");
+        close(fd);
+        return false;
+    }
+    if (!lock_image(fd)) {
+        error_setg(errp, "Memory Stick image is in use");
+        close(fd);
+        return false;
+    }
+    FILE *file = fdopen(fd, "r+b");
+    if (!file) {
+        error_setg_errno(errp, errno, "Opening Memory Stick image stream");
+        close(fd);
+        return false;
+    }
+    ms->image = file;
+    ms->sectors = st.st_size / DBMS_SECTOR;
+    return true;
+}
+
+void dbms_close(DB2010MemoryStick *ms)
+{
+    if (ms->image) {
+        fclose(ms->image);
+    }
+    *ms = (DB2010MemoryStick){0};
+}
+
+void dbms_reset(DB2010MemoryStick *ms, uint16_t control, uint16_t enable)
+{
+    FILE *file = ms->image;
+    uint32_t sectors = ms->sectors;
+    *ms = (DB2010MemoryStick){
+        .image = file, .sectors = sectors, .control = control, .enable = enable,
+        .card_int = CARD_CED, .read_offset = 2, .read_size = 6,
+        .write_offset = 0x10, .write_size = 1,
+    };
+    ms->regs[4] = 1; /* MS PRO, category memory, class read/write. */
+    ms->regs[0x10] = 0x80; /* Serial mode at power-on. */
+}
+
+static void card_event(DB2010MemoryStick *ms, uint8_t bits)
+{
+    ms->card_int = bits;
+    ms->status |= MS_EVENT;
+}
+
+static void card_command(DB2010MemoryStick *ms, uint8_t command,
+                         uint16_t count, uint32_t address)
+{
+    /* R1DB001 sends a byte offset for READ_ATRB and sector numbers for
+     * READ_DATA and WRITE_DATA. */
+    const bool attr = command == CARD_ATTR;
+    const uint32_t lba = attr ? address / DBMS_SECTOR : address;
+    ms->last_card_command = command;
+    ms->last_card_count = count;
+    ms->last_card_address = address;
+    ms->operation = 0;
+    ms->remaining = 0;
+    uint32_t limit = attr ? ATTR_SECTORS : ms->sectors;
+    switch (command) {
+    case CARD_READ: case CARD_WRITE: case CARD_ATTR:
+        if (!count || (attr && address % DBMS_SECTOR) || lba >= limit ||
+            count > limit - lba) {
+            card_event(ms, CARD_CED | CARD_ERR);
+            break;
+        }
+        ms->operation = command;
+        ms->lba = lba;
+        ms->remaining = count;
+        card_event(ms, CARD_BREQ);
+        break;
+    case CARD_STOP:
+    case 0x10: /* Memory Stick RESET. */
+        card_event(ms, CARD_CED);
+        break;
+    default:
+        card_event(ms, CARD_CED | CARD_NAK);
+        break;
+    }
+}
+
+static void attribute_sector(DB2010MemoryStick *ms)
+{
+    memset(ms->rx, 0, sizeof(ms->rx));
+    if (ms->lba == 0) {
+        stw_be_p(ms->rx, 0xa5c3);
+        stw_be_p(ms->rx + 2, 0x0100);
+        ms->rx[4] = 1;
+        stl_be_p(ms->rx + 0x10, 0x200); /* R1DB001 expects a separate sector. */
+        stl_be_p(ms->rx + 0x14, 0x60);
+        ms->rx[0x18] = 0x10; /* System Information. */
+    } else if (ms->lba == 1) {
+        uint16_t blocks = ms->sectors / BLOCK_SECTORS;
+        ms->rx[0] = 2;
+        stw_be_p(ms->rx + 2, BLOCK_SECTORS);
+        stw_be_p(ms->rx + 4, blocks);
+        stw_be_p(ms->rx + 6, blocks);
+        stw_be_p(ms->rx + 8, DBMS_SECTOR);
+        stw_be_p(ms->rx + 0x2c, DBMS_SECTOR);
+        memcpy(ms->rx + 0x40, "Ph0nix MS PRO", 13);
+    }
+}
+
+static bool sync_image(FILE *image)
+{
+    if (fflush(image)) {
+        return false;
+    }
+#ifdef _WIN32
+    return _commit(fileno(image)) == 0;
+#else
+    return fsync(fileno(image)) == 0;
+#endif
+}
+
+static bool data_sector(DB2010MemoryStick *ms, bool write)
+{
+    clearerr(ms->image);
+    if (fseek(ms->image, (long)ms->lba * DBMS_SECTOR, SEEK_SET)) {
+        return false;
+    }
+    if (!write) {
+        return fread(ms->rx, 1, DBMS_SECTOR, ms->image) == DBMS_SECTOR;
+    }
+    return fwrite(ms->tx, 1, DBMS_SECTOR, ms->image) == DBMS_SECTOR &&
+           sync_image(ms->image);
+}
+
+static void sector_done(DB2010MemoryStick *ms, bool ok)
+{
+    if (ok) {
+        switch (ms->operation) {
+        case CARD_READ: ms->reads++; break;
+        case CARD_WRITE: ms->writes++; break;
+        case CARD_ATTR: ms->attributes++; break;
+        }
+        ms->lba++;
+        if (--ms->remaining) {
+            /* The attribute reader drains the whole request before it reads
+             * another GET_INT; keep the controller IRQ enabled for each TPC. */
+            if (ms->operation != CARD_ATTR) {
+                card_event(ms, CARD_BREQ);
+            }
+            return;
+        }
+    }
+    ms->operation = 0;
+    ms->remaining = 0;
+    card_event(ms, CARD_CED | (ok ? 0 : CARD_ERR));
+}
+
+static void complete(DB2010MemoryStick *ms, bool ok)
+{
+    ms->active_tpc = 0;
+    ms->status |= MS_COMPLETE | (ok ? 0 : MS_ERROR);
+}
+
+static void consume_tx(DB2010MemoryStick *ms)
+{
+    unsigned tpc = ms->active_tpc >> 12;
+    unsigned n = ms->active_tpc & 0xfff;
+    if (!ms->active_tpc || ms->tx_len < n) {
+        return;
+    }
+    bool ok = ms->tx_len == n;
+    if (ok) {
+        switch (tpc) {
+        case 8: /* SET_RW_REG_ADRS */
+            ms->read_offset = ms->tx[0];
+            ms->read_size = ms->tx[1];
+            ms->write_offset = ms->tx[2];
+            ms->write_size = ms->tx[3];
+            break;
+        case 9: /* EX_SET_CMD: command, big-endian count and address. */
+            card_command(ms, ms->tx[0], lduw_be_p(ms->tx + 1), ldl_be_p(ms->tx + 3));
+            break;
+        case 0xb: /* WRITE_REG */
+            ok = n <= ms->write_size && ms->write_offset >= 0x10 &&
+                 ms->write_offset + n <= sizeof(ms->regs);
+            if (ok) {
+                memcpy(ms->regs + ms->write_offset, ms->tx, n);
+            }
+            break;
+        case 0xd:
+            ok = ms->remaining && ms->operation == CARD_WRITE;
+            if (ok) {
+                ok = data_sector(ms, true);
+                sector_done(ms, ok);
+            }
+            break;
+        case 0xe: /* SET_CMD uses parameters previously written to the registers. */
+            card_command(ms, ms->tx[0], lduw_be_p(ms->regs + 0x11),
+                         ldl_be_p(ms->regs + 0x13));
+            break;
+        default:
+            ok = false;
+            break;
+        }
+    }
+    ms->tx_len = 0;
+    complete(ms, ok);
+}
+
+static void issue_tpc(DB2010MemoryStick *ms, uint16_t value)
+{
+    ms->last_tpc = value;
+    if (!ms->first_tpc) {
+        ms->first_tpc = value;
+    }
+    ms->active_tpc = value;
+    ms->rx_pos = ms->rx_len = 0;
+    unsigned n = value & 0xfff;
+    switch (value >> 12) {
+    case 2: /* READ_LONG_DATA */
+        if (n == DBMS_SECTOR && ms->remaining &&
+            (ms->operation == CARD_ATTR || ms->operation == CARD_READ)) {
+            if (ms->operation == CARD_ATTR) {
+                attribute_sector(ms);
+            } else if (!data_sector(ms, false)) {
+                sector_done(ms, false);
+                /* Let the firmware finish draining the failed transfer. */
+                memset(ms->rx, 0, sizeof(ms->rx));
+                ms->rx_len = n;
+                complete(ms, false);
+                return;
+            }
+            ms->rx_len = n;
+            return;
+        }
+        break;
+    case 3: /* READ_SHORT_DATA */
+        if (n == 32) {
+            memset(ms->rx, 0, n);
+            ms->rx_len = n;
+            return;
+        }
+        break;
+    case 4: /* READ_REG */
+        if (n && n <= ms->read_size && ms->read_offset + n <= sizeof(ms->regs)) {
+            ms->regs[1] = ms->card_int;
+            memcpy(ms->rx, ms->regs + ms->read_offset, n);
+            ms->rx_len = n;
+            return;
+        }
+        break;
+    case 7: /* GET_INT */
+        if (n == 1) {
+            ms->rx[0] = ms->card_int;
+            ms->rx_len = n;
+            return;
+        }
+        break;
+    case 8: case 9: case 0xb: case 0xd: case 0xe:
+        if (value == 0x8004 || value == 0x9007 || value == 0xd200 ||
+            value == 0xe001 || ((value >> 12) == 0xb && n && n <= 16)) {
+            consume_tx(ms);
+            return;
+        }
+        break;
+    }
+    if ((value >> 12) < 8 && n && n <= sizeof(ms->rx)) {
+        memset(ms->rx, 0, n);
+        ms->rx_len = n;
+    }
+    ms->tx_len = 0;
+    complete(ms, false);
+}
+
+const char *dbms_access(DB2010MemoryStick *ms, DB2010Timer *timer, DB2010Access *a)
+{
+    uint32_t offset = a->address - DBMS_BASE;
+    if (a->size != ((offset == 0x20 || offset == 0x24) ? 4 : 2)) {
+        return "memorystick_register_width_unmodeled";
+    }
+    unsigned mode, n;
+    switch (offset) {
+    case 0x00:
+        if (!a->write) { break; }
+        if (a->commit) { issue_tpc(ms, a->value); }
+        goto done;
+    case 0x08:
+        if (!a->write) { a->value = ms->control; }
+        else if (a->commit) { ms->control = a->value; }
+        goto done;
+    case 0x0c:
+        if (!a->write) { a->value = ms->status; }
+        else if (a->commit) { ms->status &= ~a->value; }
+        goto done;
+    case 0x10:
+        if (!a->write) { a->value = ms->enable; }
+        else if (a->commit) { ms->enable = a->value; }
+        goto done;
+    case 0x1c:
+        if (!a->write) { a->value = ms->fifo_mode; }
+        else if (a->commit) { ms->fifo_mode = a->value; }
+        goto done;
+    case 0x20:
+        if (a->write) { break; }
+        mode = ms->fifo_mode & 3;
+        if (mode && mode != 3) { return "memorystick_rx_mode_unmodeled"; }
+        n = MIN(mode + 1, ms->rx_len - ms->rx_pos);
+        a->value = 0;
+        for (unsigned i = 0; i < n; i++) {
+            a->value |= (uint32_t)ms->rx[ms->rx_pos + i] << (i * 8);
+        }
+        if (a->commit && n) {
+            ms->rx_pos += n;
+            if (ms->active_tpc && ms->rx_pos == ms->rx_len) {
+                if (ms->active_tpc == 0x2200) { sector_done(ms, true); }
+                complete(ms, true);
+            }
+        }
+        goto done;
+    case 0x24:
+        if (!a->write) { break; }
+        mode = (ms->fifo_mode >> 4) & 3;
+        if (mode && mode != 3) { return "memorystick_tx_mode_unmodeled"; }
+        n = mode + 1;
+        if (ms->tx_len + n > (ms->active_tpc ? sizeof(ms->tx) : MAX_FIFO)) {
+            return "memorystick_tx_overrun";
+        }
+        if (a->commit) {
+            for (unsigned i = 0; i < n; i++) {
+                ms->tx[ms->tx_len++] = a->value >> (i * 8);
+            }
+            consume_tx(ms);
+        }
+        goto done;
+    case 0x2c:
+        if (a->write) { break; }
+        /* An active transfer consumes TX bytes as they arrive and refills RX. */
+        a->value = MIN(MAX_FIFO, ms->rx_len - ms->rx_pos) |
+                   ((ms->active_tpc ? 0 : ms->tx_len) << 8);
+        goto done;
+    }
+    return "memorystick_register_access_unmodeled";
+
+done:
+    if (a->commit && timer) {
+        dbtimer_set_line(timer, DBIRQ_MEMORYSTICK,
+                         (ms->enable & MS_COMPLETE) && ms->status);
+    }
+    return NULL;
+}
diff --git a/hw/arm/db2010-memorystick.h b/hw/arm/db2010-memorystick.h
new file mode 100644
index 0000000000000000000000000000000000000000..96e2f3f5048224492470b07872d39141e4a4506f
--- /dev/null
+++ b/hw/arm/db2010-memorystick.h
@@ -0,0 +1,33 @@
+/* Memory Stick PRO card and DB2010 programmed I/O controller.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef DB2010_MEMORYSTICK_H
+#define DB2010_MEMORYSTICK_H
+
+#include "db2010-bus.h"
+#include "db2010-timer.h"
+
+#define DBMS_BASE 0xfc010000u
+#define DBMS_SECTOR 512
+
+typedef struct DB2010MemoryStick {
+    FILE *image;
+    uint32_t sectors;
+    uint64_t reads, writes, attributes;
+    uint16_t control, status, enable, fifo_mode;
+    uint16_t first_tpc, active_tpc, last_tpc;
+    uint16_t rx_pos, rx_len, tx_len;
+    uint8_t tx[DBMS_SECTOR], rx[DBMS_SECTOR];
+    uint8_t read_offset, read_size, write_offset, write_size;
+    uint8_t regs[32], card_int, operation;
+    uint32_t lba;
+    uint16_t remaining, last_card_count;
+    uint32_t last_card_address;
+    uint8_t last_card_command;
+} DB2010MemoryStick;
+
+bool dbms_open(DB2010MemoryStick *ms, const char *path, Error **errp);
+void dbms_reset(DB2010MemoryStick *ms, uint16_t control, uint16_t enable);
+void dbms_close(DB2010MemoryStick *ms);
+const char *dbms_access(DB2010MemoryStick *ms, DB2010Timer *timer, DB2010Access *a);
+
+#endif
