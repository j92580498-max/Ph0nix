diff --git a/hw/arm/db2010-panel.c b/hw/arm/db2010-panel.c
index 5c29fb6..cb8585c 100644
--- a/hw/arm/db2010-panel.c
+++ b/hw/arm/db2010-panel.c
@@ -65,12 +65,25 @@ static const char *dbpanel_validate_dma(DB2010Panel *p, unsigned bytes)
 
 static void dbpanel_stream_pixels(DB2010Panel *p, const uint8_t *data, unsigned bytes)
 {
-    for (unsigned i = 0; i < bytes; i += 2) {
-        unsigned x = p->cursor & 255, y = p->cursor >> 8, offset = y * 176 + x;
-        memcpy(p->pixels + offset * 2, data + i, 2);
-        if (!p->pixel_known[offset]) { p->pixel_known[offset] = 1; p->known_pixels++; }
-        if (++x == 176) { x = 0; if (++y == 220) { y = 0; } }
+    unsigned remaining = (bytes + 1) / 2;
+    while (remaining) {
+        unsigned x = p->cursor & 255, y = p->cursor >> 8;
+        unsigned count = MIN(remaining, 176 - x), offset = y * 176 + x;
+        /* Every native burst still occurs at its original deadline. Copy its
+         * contiguous RGB565 span together, splitting at retained GRAM rows.
+         * Once all pixels are known, no per-pixel provenance update remains. */
+        memcpy(p->pixels + offset * 2, data, count * 2);
+        if (p->known_pixels != DBPANEL_PIXELS) {
+            for (unsigned i = 0; i < count; i++) {
+                if (!p->pixel_known[offset + i]) {
+                    p->pixel_known[offset + i] = 1; p->known_pixels++;
+                }
+            }
+        }
+        x += count;
+        if (x == 176) { x = 0; if (++y == 220) { y = 0; } }
         p->cursor = (y << 8) | x;
+        remaining -= count; data += count * 2;
     }
 }
 
