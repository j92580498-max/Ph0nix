+void dbsim_card_init_ph0nix(DB2010SimCard *c)
+{
+    dbsim_card_init(c);
+    /* TS 24.008 mobile identity: IMSI 001010123456789, odd digit count,
+     * identity type 1. MCC 001 is a test network; there is no subscriber
+     * key or live cellular service. The legacy stub's identity nibble 0
+     * was invalid and could make the firmware reject the card. */
+    static const uint8_t imsi[] = {8,0x09,0x10,0x10,0x10,0x32,0x54,0x76,0x98};
+    memcpy(c->files[5].data, imsi, sizeof(imsi));
+    /* TS 51.011: SST service 17 (SPN) allocated and activated. */
+    c->files[8].size = 5; c->files[8].data[4] = 3;
+    memset(c->files[18].data, 0xff, 16);
+    memcpy(c->files[18].data, "ph0nix", 6); /* CPHS operator name */
+    DB2010SimFile *spn = &c->files[DBSIM_LEGACY_FILES];
+    *spn = (DB2010SimFile){.parent=0x7f20,.id=0x6f46,.size=17,.structure=0};
+    memset(spn->data, 0xff, spn->size);
+    spn->data[0] = 0; /* Display SPN on the home PLMN. */
+    memcpy(spn->data + 1, "ph0nix", 6);
+}
