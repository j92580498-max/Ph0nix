+int64_t db2010_data_uart_deadline(DB2010Uart *s)
+{
+    if (!s->data_enabled) { return -1; }
+    int64_t due = s->data_idle_pending ? s->data_idle_due : -1;
+    if (s->data_wire_count && s->data_count < sizeof(s->data_rx)) {
+        due = due < 0 ? s->data_shift_due : MIN(due, s->data_shift_due);
+    }
+    return due;
+}
+void db2010_data_uart_advance(DB2010Uart *s, uint64_t now)
+{
+    /* Socket readiness is not a UART clock. Serialize 8N1 characters at
+     * the declared cable's 9600 baud, with bounded ingress and FIFO queues.
+     * Native RX interrupts and software flow control now get CPU time
+     * between characters, rather than draining an entire host file in an ISR. */
+    while (s->data_wire_count && s->data_count < sizeof(s->data_rx) &&
+           now >= s->data_shift_due) {
+        uint8_t byte = s->data_wire_rx[s->data_wire_head];
+        s->data_wire_head = (s->data_wire_head + 1) % sizeof(s->data_wire_rx);
+        s->data_wire_count--;
+        s->data_rx[(s->data_head + s->data_count++) % sizeof(s->data_rx)] = byte;
+        if (s->data_mode_known && (s->data_mode & 7) == 2) {
+            if (s->data_training == 1 && (byte == 'T' || byte == 't')) {
+                s->data_autobaud = true; s->data_autobauds++; s->data_training = 2;
+            } else if (s->data_training != 2) {
+                s->data_training = (byte == 'A' || byte == 'a') ? 1 : 0;
+            }
+        }
+        s->data_idle_pending = true;
+        s->data_idle_due = s->data_shift_due + UINT64_C(4166668);
+        s->data_shift_due += UINT64_C(1041667);
+        qemu_chr_fe_accept_input(&s->uart[0]);
+    }
+    if (s->data_idle_pending && now >= s->data_idle_due) {
+        s->data_idle_pending = false;
+        s->data_timeout = true;
+    }
