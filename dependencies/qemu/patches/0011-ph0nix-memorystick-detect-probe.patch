+static bool get_memorystick_probe_inserted(Object *obj, Error **errp)
+{
+    DB2010MachineState *s = DB2010_MACHINE(obj);
+    return s->bank && s->bank->memorystick_present;
+}
+
+static void set_memorystick_probe_inserted(Object *obj, bool present,
+                                          Error **errp)
+{
+    DB2010MachineState *s = DB2010_MACHINE(obj);
+    if (s->bank && s->bank->memorystick.image) {
+        error_setg(errp, "An image-backed Memory Stick stays inserted until the engine stops");
+        return;
+    }
+    if (!s->cpu || !dbreg_memorystick_probe(s->bank, present)) {
+        error_setg(errp, "DB2010 Memory Stick probe requires an initialized GPIO42 slot");
+    }
+}
+
+static void set_memorystick_image(Object *obj, const char *path, Error **errp)
+{
+    DB2010MachineState *s = DB2010_MACHINE(obj);
+    if (!s->cpu || !dbreg_memorystick_ready(s->bank) ||
+        s->bank->memorystick_present) {
+        error_setg(errp, "Memory Stick attachment requires an initialized, empty GPIO42 slot");
+        return;
+    }
+    DB2010Register *control = dbreg_find(s->bank, DBMS_BASE + 8);
+    DB2010Register *enable = dbreg_find(s->bank, DBMS_BASE + 0x10);
+    if (!control || !enable || !dbreg_known(control) || !dbreg_known(enable)) {
+        /* Profiles without configured controller registers cannot attach media. */
+        error_setg(errp, "Memory Stick controller registers are unavailable");
+        return;
+    }
+    DB2010MemoryStick *ms = &s->bank->memorystick;
+    if (!dbms_open(ms, path, errp)) {
+        return;
+    }
+    dbms_reset(ms, control->value, enable->value);
+    dbreg_memorystick_probe(s->bank, true);
+}
+
+static char *get_memorystick_probe_status(Object *obj, Error **errp)
+{
+    DB2010MachineState *s = DB2010_MACHINE(obj);
+    if (!s->bank || !s->bank->has_memorystick_slot || !s->bank->timer) {
+        error_setg(errp, "DB2010 has no GPIO42 slot");
+        return NULL;
+    }
+    g_autoptr(QDict) status = qdict_new();
+    qdict_put_bool(status, "card_present", s->bank->memorystick_present);
+    qdict_put_bool(status, "detect_pending", s->bank->memorystick_detect_pending);
+    qdict_put_int(status, "detect_irqs", s->timer->state.memorystick_detect_irqs);
+    qdict_put_int(status, "controller_accesses", s->bank->memorystick_probe_accesses);
+    DB2010MemoryStick *ms = &s->bank->memorystick;
+    qdict_put_int(status, "first_command", ms->image ? ms->first_tpc :
+                  s->bank->memorystick_probe_command);
+    qdict_put_int(status, "last_command", ms->last_tpc);
+    qdict_put_int(status, "controller_irqs", s->timer->state.memorystick_irqs);
+    qdict_put_int(status, "controller_enable", ms->enable);
+    qdict_put_int(status, "controller_status", ms->status);
+    qdict_put_int(status, "card_int", ms->card_int);
+    qdict_put_int(status, "operation", ms->operation);
+    qdict_put_int(status, "last_card_command", ms->last_card_command);
+    qdict_put_int(status, "last_card_address", ms->last_card_address);
+    qdict_put_int(status, "last_card_count", ms->last_card_count);
+    qdict_put_int(status, "sectors_remaining", ms->remaining);
+    qdict_put_int(status, "rx_available", ms->rx_len - ms->rx_pos);
+    qdict_put_int(status, "tx_bytes", ms->tx_len);
+    qdict_put_int(status, "lba", ms->lba);
+    qdict_put_int(status, "sectors_read", ms->reads);
+    qdict_put_int(status, "sectors_written", ms->writes);
