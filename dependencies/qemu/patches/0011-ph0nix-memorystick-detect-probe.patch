diff --git a/hw/arm/db2010-register-bank.c b/hw/arm/db2010-register-bank.c
index 447c5d3e0431a6e7b2f549300fc33b59cf4ffbdb..f3dfbb2a5b9e3234d8a8c00ff89b4bb5b13e2fa7 100644
--- a/hw/arm/db2010-register-bank.c
+++ b/hw/arm/db2010-register-bank.c
@@ -5,6 +5,50 @@
 #include "qobject/qdict.h"
 #include "qobject/qlist.h"
 
+#define MS_DETECT_PIN 4
+#define MS_GPIO_DIRECTION 0xf900002a
+#define MS_GPIO_ENABLE 0xf900002c
+#define MS_GPIO_POLARITY 0xf900002e
+#define MS_GPIO_PENDING 0xf9000030
+
+/* Only GPIO42 is driven; the firmware's output latch and neighboring bits
+ * remain independent of the mechanical switch. */
+bool dbreg_memorystick_ready(DB2010RegisterBank *s)
+{
+    if (!s->has_memorystick_slot || !s->timer) {
+        return false;
+    }
+    DB2010Register *direction = dbreg_find(s, MS_GPIO_DIRECTION);
+    DB2010Register *enable = dbreg_find(s, MS_GPIO_ENABLE);
+    DB2010Register *polarity = dbreg_find(s, MS_GPIO_POLARITY);
+    return direction && enable && polarity &&
+        dbreg_known(direction) && dbreg_known(enable) && dbreg_known(polarity) &&
+        direction->width == 2 && enable->width == 2 && polarity->width == 2;
+}
+
+bool dbreg_memorystick_probe(DB2010RegisterBank *s, bool present)
+{
+    if (!dbreg_memorystick_ready(s)) {
+        return false;
+    }
+    if (s->memorystick_present == present) {
+        return true;
+    }
+    s->memorystick_probe = true;
+    s->memorystick_present = present;
+    DB2010Register *direction = dbreg_find(s, MS_GPIO_DIRECTION);
+    DB2010Register *enable = dbreg_find(s, MS_GPIO_ENABLE);
+    DB2010Register *polarity = dbreg_find(s, MS_GPIO_POLARITY);
+    /* A set polarity bit watches for the high-to-low transition. */
+    if (!(direction->value & MS_DETECT_PIN) &&
+        (enable->value & MS_DETECT_PIN) &&
+        !!(polarity->value & MS_DETECT_PIN) == present) {
+        s->memorystick_detect_pending = true;
+        dbtimer_set_line(s->timer, DBIRQ_MEMORYSTICK_DETECT, true);
+    }
+    return true;
+}
+
 static const char *bank_action(void *opaque, const DB2010DecodedAccess *d,
