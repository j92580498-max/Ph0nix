 #include "qemu/osdep.h"
 #include "db2010-midi-stream.h"
 
+#ifdef CONFIG_DB2010_SOUNDFONT
+#define TSF_IMPLEMENTATION
+#include <tsf.h>
+
+static void soundfont_program(DB2010MidiStream *m, unsigned channel)
+{
+    tsf_channel_set_bank(m->soundfont, channel, m->synth.bank[channel]);
+    if (!tsf_channel_set_presetnumber(m->soundfont, channel,
+                                      m->synth.program[channel], channel == 9)) {
+        tsf_channel_set_presetnumber(m->soundfont, channel, 0, channel == 9);
+    }
+}
+
+static void soundfont_start(DB2010MidiStream *m)
+{
+    static bool loaded;
+    static tsf *bank;
+    if (!loaded) {
+        const char *path = getenv("PH0NIX_MIDI_SOUNDFONT");
+        loaded = true;
+        if (path && *path) {
+            bank = tsf_load_filename(path);
+            if (bank) {
+                tsf_set_output(bank, TSF_STEREO_INTERLEAVED, 48000, -8.0f);
+            } else {
+                fprintf(stderr, "K750i MIDI: could not load the bundled SoundFont\n");
+            }
+        }
+    }
+    m->soundfont = bank ? tsf_copy(bank) : NULL;
+    if (m->soundfont && !tsf_set_max_voices(m->soundfont, DB2010_MIDI_VOICES)) {
+        db2010_midi_stream_discard_soundfont(m);
+    }
+    if (m->soundfont) {
+        for (unsigned channel = 0; channel < 16; channel++) {
+            soundfont_program(m, channel);
+        }
+    }
+}
+
+static void soundfont_event(DB2010MidiStream *m, unsigned status,
+                            unsigned first, unsigned second)
+{
+    tsf *font = m->soundfont;
+    unsigned channel = status & 15;
+    DB2010MidiSynth *synth = &m->synth;
+    switch (status >> 4) {
+    case 8:
+    case 9:
+        if ((status >> 4) == 8 || !second) {
+            tsf_channel_note_off(font, channel, first);
+        } else if (synth->enabled_channels & (1u << channel)) {
+            tsf_channel_note_on(font, channel, first, second / 127.0f);
+        }
+        break;
+    case 11:
+        if (first == 7 || first == 11 || first == 121) {
+            tsf_channel_set_volume(font, channel,
+                (synth->volume[channel] * synth->expression[channel]) / (127.0f * 127.0f));
+        }
+        if (first == 10) {
+            tsf_channel_set_pan(font, channel, second / 127.0f);
+        } else if (first == 120) {
+            tsf_channel_sounds_off_all(font, channel);
+        } else if (first == 123) {
+            tsf_channel_note_off_all(font, channel);
+        } else if (first == 121) {
+            tsf_channel_set_pitchwheel(font, channel, synth->bend[channel]);
+        }
+        break;
+    case 12:
+        soundfont_program(m, channel);
+        break;
+    case 14:
+        tsf_channel_set_pitchwheel(font, channel, synth->bend[channel]);
+        break;
+    }
+}
+#endif
+
+bool db2010_midi_stream_uses_soundfont(const DB2010MidiStream *m)
+{
+#ifdef CONFIG_DB2010_SOUNDFONT
+    return m->soundfont != NULL;
+#else
+    return false;
+#endif
+}
+
+void db2010_midi_stream_discard_soundfont(DB2010MidiStream *m)
+{
+#ifdef CONFIG_DB2010_SOUNDFONT
+    if (m->soundfont) {
+        tsf_close(m->soundfont);
+        m->soundfont = NULL;
+    }
+#endif
+}
