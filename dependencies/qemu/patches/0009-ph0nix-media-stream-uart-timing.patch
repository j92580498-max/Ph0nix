+static bool dsp_code_matches(DB2010FaTransfer *f, unsigned pc,
+                             const uint8_t *code, unsigned bytes)
+{
+    for (unsigned i = 0; i < bytes; i++) {
+        uint16_t word;
+        unsigned address = pc + i;
+        if (!dbfa_word(f, address / 2, &word) ||
+            (uint8_t)(word >> (address & 1 ? 0 : 8)) != code[i]) {
+            return false;
+        }
+    }
+    return true;
+}
