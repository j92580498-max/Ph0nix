+static const char *dbdsp_version(DB2010DspPeer *p)
+{
+    /* The ARM DSP manager sends 0201 in an allocated 202-byte message.
+     * Its uploaded C55x routine loads the identity address with AMAR,
+     * copies the terminated halfword string and stores 0202 in the same
+     * message. These locations were read from the original K750i uploads;
+     * no identity string or successful media result is invented here.
+     * Relocated W800 kernels use the same evidenced instructions.
+     */
+    static const struct { unsigned pc, metadata, reply_pc, channel; } kernels[] = {
+        {0x158d9, 0xb0b2, 0x15905, 0xb0f2}, /* K750i MP3 */
+        {0x15c96, 0xb2e4, 0x15cc2, 0xb32d}, /* K750i MIDI/PCM/ASR */
+        {0x15c82, 0xb2dc, 0x15cae, 0xb32a},
+        {0x15ced, 0xb2a6, 0x15d19, 0xb2eb},
+        {0x158c4, 0xb0a6, 0x158f0, 0xb0eb},
+        {0x153fc, 0xaeba, 0x15428, 0xaf03},
+        {0x1595d, 0xb30c, 0x15989, 0xb37a},
+    };
+    if (p->state.bytes < 8 || p->state.bytes > sizeof(p->state.response) ||
+        p->state.bytes % 4 ||
+        lduw_le_p(p->state.payload + p->state.bytes - 2) != 2) {
+        return "dsp_peer_version_packet_unmodeled";
+    }
+    for (unsigned k = 0; k < ARRAY_SIZE(kernels); k++) {
+        const uint8_t load[] = {0xec, 0x31, 0xbe, 0,
+            kernels[k].metadata >> 8, kernels[k].metadata & 255};
+        const uint8_t reply[] = {0xfb, 0x41, 2, 2};
+        uint16_t channel;
+        if (!dbfa_word(p->transfer, kernels[k].channel, &channel) || channel != 2 ||
+            !dsp_code_matches(p->transfer, kernels[k].pc, load, sizeof(load)) ||
+            !dsp_code_matches(p->transfer, kernels[k].reply_pc, reply, sizeof(reply))) {
+            continue;
+        }
+        memset(p->state.response, 0, sizeof(p->state.response));
+        stw_le_p(p->state.response, 0x0202);
+        for (unsigned i = 1; i < p->state.bytes / 2; i++) {
+            uint16_t character;
+            if (!dbfa_word(p->transfer, kernels[k].metadata + i - 1, &character) ||
+                character > 127) {
+                return "dsp_peer_version_identity_unmodeled";
+            }
+            stw_le_p(p->state.response + i * 2, character);
+            if (!character) {
+                p->state.reply_bytes = p->state.bytes;
+                p->state.reply_logical = 2;
+                return NULL;
+            }
+        }
+        return "dsp_peer_version_identity_unterminated";
+    }
+    return "dsp_peer_version_kernel_unmodeled";
+}
