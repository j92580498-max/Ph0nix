+static const char *pcm_decode(DB2010AudioRuntime *a)
+{
+    if (a->source_rate != 8000 || a->source_channels != 1) {
+        return "dsp_peer_audio_source_format_unmodeled";
+    }
+    if (a->eof && !a->input_bytes) {
+        a->pcm_frames = db2010_audio_resample(&a->resampler, NULL, 0, a->pcm, true, 8000);
+        return NULL;
+    }
+    /* The original WAV reader expands each unsigned source byte to a
+     * little-endian halfword (byte - 127). Captured Pool ring data matches
+     * every source sample. Its format0 option1 retains eight-bit precision;
+     * scale and saturate that native signed value for 16-bit presentation.
+     * Decode at most 20ms per tick, preserving input and resampler state. */
+    unsigned frames = MIN(a->input_bytes / 2, 160);
+    if (!frames) { return NULL; }
+    int16_t stereo[320];
+    for (unsigned i = 0; i < frames; i++) {
+        int sample = (int16_t)(a->input[i * 2] | (a->input[i * 2 + 1] << 8));
+        if (sample < -127 || sample > 128) {
+            return "dsp_peer_pcm_source_sample_unmodeled";
+        }
+        sample = MIN(sample * 256, INT16_MAX);
+        stereo[i * 2] = stereo[i * 2 + 1] = sample;
+    }
+    a->pcm_frames = db2010_audio_resample(&a->resampler, stereo, frames, a->pcm, false, 8000);
+    a->frames_decoded++;
+    a->input_bytes -= frames * 2;
+    memmove(a->input, a->input + frames * 2, a->input_bytes);
+    return NULL;
+}
+
 const char *db2010_audio_decode(DB2010AudioRuntime *a)
 {
     if (a->source_codec == 1) { return aac_decode(a); }
     if (a->source_codec == 2) { return amr_decode(a); }
+    if (a->source_codec == 3) { return pcm_decode(a); }
     if (a->source_codec) { return "dsp_peer_audio_source_format_unmodeled"; }
     unsigned rate = a->source_rate ? a->source_rate : 48000;
     unsigned channels = a->source_channels ? a->source_channels : 2;
