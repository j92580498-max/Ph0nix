new file mode 100644
index 0000000000000000000000000000000000000000..1bfc59fb0bee0a9e660829e6ba7d69066911b494
--- /dev/null
+++ b/hw/arm/db2010-amr-nb.c
@@ -0,0 +1,122 @@
+/* Reconstruct transient OpenCORE pointers from a canonical integer history.
+ * Only successful complete AMR frames commit codec state. No heap allocation,
+ * source replay or platform-dependent struct bytes enter a checkpoint.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#include "db2010-amr-nb.h"
+#include "sp_dec.h"
+#include "amrdecode.h"
+#include <limits.h>
+#include <string.h>
+
+#define HISTORY_SCHEMA UINT32_C(0x414d5201)
+#define COUNT(a) (sizeof(a) / sizeof((a)[0]))
+
+unsigned db2010_amr_nb_frame_bytes(uint8_t toc)
+{
+    static const uint8_t bytes[16] = {13, 14, 16, 18, 20, 21, 27, 32, 6,
+                                    0, 0, 0, 0, 0, 0, 1};
+    return toc & 0x83 ? 0 : bytes[(toc >> 3) & 15];
+}
+
+static bool history(DB2010AmrNb *h, Speech_Decode_FrameState *s, bool load)
+{
+    Decoder_amrState *d = &s->decoder_amrState;
+    dtx_decState *x = &d->dtxDecoderState;
+    Post_FilterState *p = &s->post_state;
+    Post_ProcessState *hp = &s->postHP_state;
+    unsigned n = 0;
+#define FIELD(v, narrow) do { \
+    if (n >= 2048) { return false; } \
+    if (load) { \
+        int32_t value = h->history[n / 1024][n % 1024]; \
+        if ((narrow) && (value < INT16_MIN || value > INT16_MAX)) { return false; } \
+        (v) = value; \
+    } else { h->history[n / 1024][n % 1024] = (v); } \
+    n++; \
+} while (0)
+#define WORD(v) FIELD(v, true)
+#define ARRAY(v) do { for (unsigned i = 0; i < COUNT(v); i++) { WORD((v)[i]); } } while (0)
+    ARRAY(d->old_exc);
+    ARRAY(d->lsp_old); ARRAY(d->mem_syn);
+    WORD(d->sharp); WORD(d->old_T0); WORD(d->prev_bf); WORD(d->prev_pdf); WORD(d->state);
+    ARRAY(d->excEnergyHist); WORD(d->T0_lagBuff); WORD(d->inBackgroundNoise);
+    WORD(d->voicedHangover); ARRAY(d->ltpGainHistory);
+    ARRAY(d->background_state.frameEnergyHist); WORD(d->background_state.bgHangover);
+    WORD(d->nodataSeed);
+    ARRAY(d->Cb_gain_averState.cbGainHistory);
+    WORD(d->Cb_gain_averState.hangVar); WORD(d->Cb_gain_averState.hangCount);
+    ARRAY(d->lsp_avg_st.lsp_meanSave);
+    ARRAY(d->lsfState.past_r_q); ARRAY(d->lsfState.past_lsf_q);
+    ARRAY(d->ec_gain_p_st.pbuf); WORD(d->ec_gain_p_st.past_gain_pit); WORD(d->ec_gain_p_st.prev_gp);
+    ARRAY(d->ec_gain_c_st.gbuf); WORD(d->ec_gain_c_st.past_gain_code); WORD(d->ec_gain_c_st.prev_gc);
+    ARRAY(d->pred_state.past_qua_en); ARRAY(d->pred_state.past_qua_en_MR122);
+    ARRAY(d->ph_disp_st.gainMem); WORD(d->ph_disp_st.prevState);
+    WORD(d->ph_disp_st.prevCbGain); WORD(d->ph_disp_st.lockFull); WORD(d->ph_disp_st.onset);
+    WORD(x->since_last_sid); WORD(x->true_sid_period_inv); WORD(x->log_en); WORD(x->old_log_en);
+    FIELD(x->L_pn_seed_rx, false);
+    ARRAY(x->lsp); ARRAY(x->lsp_old); ARRAY(x->lsf_hist); WORD(x->lsf_hist_ptr);
+    ARRAY(x->lsf_hist_mean); WORD(x->log_pg_mean); ARRAY(x->log_en_hist); WORD(x->log_en_hist_ptr);
+    WORD(x->log_en_adjust); WORD(x->dtxHangoverCount); WORD(x->decAnaElapsedCount);
+    WORD(x->sid_frame); WORD(x->valid_data); WORD(x->dtxHangoverAdded);
+    FIELD(x->dtxGlobalState, false); WORD(x->data_updated); FIELD(d->overflow, false);
+    ARRAY(p->res2); ARRAY(p->mem_syn_pst); WORD(p->preemph_state.mem_pre);
+    WORD(p->agc_state.past_gain); ARRAY(p->synth_buf);
+    WORD(hp->y2_hi); WORD(hp->y2_lo); WORD(hp->y1_hi); WORD(hp->y1_lo); WORD(hp->x0); WORD(hp->x1);
+    FIELD(s->prev_mode, false);
+#undef ARRAY
+#undef WORD
+#undef FIELD
+    if (load) {
+        if (!h->primed || h->tags[0] != n || h->tags[1] != HISTORY_SCHEMA ||
+            h->reserved[0] || h->reserved[1] ||
+            s->prev_mode < MR475 || s->prev_mode > MRDTX ||
+            x->dtxGlobalState < SPEECH || x->dtxGlobalState > DTX_MUTE ||
+            x->lsf_hist_ptr < 0 || x->lsf_hist_ptr >= M * DTX_HIST_SIZE || x->lsf_hist_ptr % M ||
+            x->log_en_hist_ptr < 0 || x->log_en_hist_ptr >= DTX_HIST_SIZE ||
+            d->old_T0 < 0 || d->old_T0 > PIT_MAX ||
+            d->ph_disp_st.prevState < 0 || d->ph_disp_st.prevState > 2) { return false; }
+        for (unsigned i = n; i < 2048; i++) {
+            if (h->history[i / 1024][i % 1024]) { return false; }
+        }
+    } else {
+        h->tags[0] = n; h->tags[1] = HISTORY_SCHEMA;
+        h->reserved[0] = h->reserved[1] = 0;
+    }
+    return true;
+}
+
+bool db2010_amr_nb_state_valid(const DB2010AmrNb *state)
+{
+    DB2010AmrNb copy = *state;
+    Speech_Decode_FrameState transient = {0};
+    if (!copy.primed) {
+        if (copy.tags[0] || copy.tags[1] || copy.reserved[0] || copy.reserved[1]) { return false; }
+        for (unsigned i = 0; i < 2048; i++) {
+            if (copy.history[i / 1024][i % 1024]) { return false; }
+        }
+        return true;
+    }
+    return history(&copy, &transient, true);
+}
+
+bool db2010_amr_nb_decode(DB2010AmrNb *state, const uint8_t *frame,
+                          unsigned bytes, int16_t output[160])
+{
+    Speech_Decode_FrameState transient = {0};
+    DB2010AmrNb next = *state;
+    if (!bytes || bytes != db2010_amr_nb_frame_bytes(frame[0]) ||
+        Decoder_amr_init(&transient.decoder_amrState) || Speech_Decode_Frame_reset(&transient)) {
+        return false;
+    }
+    if (next.primed && !history(&next, &transient, true)) { return false; }
+    if (!next.primed && !db2010_amr_nb_state_valid(&next)) { return false; }
+    unsigned type = (frame[0] >> 3) & 15;
+    if (!(frame[0] & 4)) { type = 15; } /* Same bad-frame policy as OpenCORE's public interface. */
+    if (AMRDecode(&transient, (enum Frame_Type_3GPP)type, (UWord8 *)frame + 1, output, MIME_IETF) < 0) {
+        return false;
+    }
+    if (!history(&next, &transient, false)) { return false; }
+    next.primed = true;
+    *state = next;
+    return true;
+}
diff --git a/hw/arm/db2010-amr-nb.h b/hw/arm/db2010-amr-nb.h
new file mode 100644
index 0000000000000000000000000000000000000000..03be8505c0d89678651250be57007ef9a3a6eece
--- /dev/null
+++ b/hw/arm/db2010-amr-nb.h
@@ -0,0 +1,22 @@
+/* Fixed-point AMR-NB host service with portable, bounded decoder history.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_ARM_DB2010_AMR_NB_H
+#define HW_ARM_DB2010_AMR_NB_H
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Same common initial sequence and size as DB2010AacLc. source_codec tags
+ * the union. The existing checkpoint28 history words retain their layout;
+ * AMR stores individual integer values, never pointers, padding or replay. */
+typedef struct DB2010AmrNb {
+    bool primed;
+    uint8_t reserved[2];
+    uint32_t tags[2];
+    int32_t history[2][1024];
+} DB2010AmrNb;
+
+unsigned db2010_amr_nb_frame_bytes(uint8_t toc);
+bool db2010_amr_nb_state_valid(const DB2010AmrNb *state);
+bool db2010_amr_nb_decode(DB2010AmrNb *state, const uint8_t *frame,
+                          unsigned bytes, int16_t output[160]);
+#endif
diff --git a/hw/arm/db2010-audio-codec.c b/hw/arm/db2010-audio-codec.c
index 8aebc90980f0270bddce1df31952a69219150ef6..0b279a9956177e4db5d9b1b9d594cacfa5519bb0 100644
--- a/hw/arm/db2010-audio-codec.c
+++ b/hw/arm/db2010-audio-codec.c
@@ -16,6 +16,13 @@ static bool layer3_header(const uint8_t *b)
 
 unsigned db2010_audio_frame_bytes(DB2010AudioRuntime *a)
 {
+    if (a->source_codec == 2) {
+        if (!a->input_bytes) { return 1; }
+        unsigned bytes = db2010_amr_nb_frame_bytes(a->input[0]);
+        /* Captured Tennis FT6 and FT7 use fixed 17-halfword source slots:
+         * 27 MIME bytes plus 7 zero bytes, or 32 MIME bytes plus 2 zeros. */
+        return bytes ? DB2010_AMR_NATIVE_FRAME_BYTES : 1;
+    }
     if (a->source_codec == 1) {
         if (a->input_bytes < 8) { return 8; }
         unsigned bytes = (a->input[4] << 5) | (a->input[5] >> 3);
@@ -62,9 +69,39 @@ static const char *aac_decode(DB2010AudioRuntime *a)
     return NULL;
 }
 
+static const char *amr_decode(DB2010AudioRuntime *a)
+{
+    if (a->source_rate != 8000 || a->source_channels != 1) {
+        return "dsp_peer_audio_source_format_unmodeled";
+    }
+    if (a->eof && !a->input_bytes) {
+        a->pcm_frames = db2010_audio_resample(&a->resampler, NULL, 0, a->pcm, true, 8000);
+        return NULL;
+    }
+    if (!a->input_bytes) { return NULL; }
+    unsigned bytes = db2010_amr_nb_frame_bytes(a->input[0]);
+    if (!bytes) { return "dsp_peer_amr_source_header_unmodeled"; }
+    unsigned padded = DB2010_AMR_NATIVE_FRAME_BYTES;
+    if (a->input_bytes < padded) { return NULL; }
+    for (unsigned i = bytes; i < padded; i++) {
+        if (a->input[i]) { return "dsp_peer_amr_alignment_unmodeled"; }
+    }
+    int16_t mono[160], stereo[320];
+    if (!db2010_amr_nb_decode(&a->amr, a->input, bytes, mono)) {
+        return "dsp_peer_amr_decode_unmodeled";
+    }
+    for (unsigned i = 0; i < 160; i++) { stereo[i * 2] = stereo[i * 2 + 1] = mono[i]; }
+    a->pcm_frames = db2010_audio_resample(&a->resampler, stereo, 160, a->pcm, false, 8000);
+    a->frames_decoded++;
+    a->input_bytes -= padded;
+    memmove(a->input, a->input + padded, a->input_bytes);
+    return NULL;
+}
+
 const char *db2010_audio_decode(DB2010AudioRuntime *a)
 {
     if (a->source_codec == 1) { return aac_decode(a); }
+    if (a->source_codec == 2) { return amr_decode(a); }
     if (a->source_codec) { return "dsp_peer_audio_source_format_unmodeled"; }
     unsigned rate = a->source_rate ? a->source_rate : 48000;
     unsigned channels = a->source_channels ? a->source_channels : 2;
