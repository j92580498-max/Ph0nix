diff --git a/hw/arm/db2010-operator-name.S b/hw/arm/db2010-operator-name.S
new file mode 100644
index 0000000000000000000000000000000000000000..482de4208fc4ee2df0638fee4fdbc104b0cee9b5
--- /dev/null
+++ b/hw/arm/db2010-operator-name.S
@@ -0,0 +1,95 @@
+/* K750 R1DB001 native standby branding, executed by the guest ARM926.
+ * The original StatusIndication renderer still draws and centers the text.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Assemble for armv5te/thumb and link .text at 0x44018000. */
+.syntax unified
+.arch armv5te
+.thumb
+.section .text
+.balign 4
+.global ph0nix_operator_redraw
+.thumb_func
+ph0nix_operator_redraw:
+    push {r0, r1, r2, r4, r5, r6, r7, lr}
+    cmp r0, #0
+    beq original_redraw
+    movs r3, #0xcc
+    ldr r5, [r0, r3]              /* StatusIndication layout */
+    cmp r5, #0
+    beq original_redraw
+    ldr r6, [r5, #0x78]           /* 12-byte text records */
+    cmp r6, #0
+    beq original_redraw
+    ldr r0, [r6, #16]             /* Primary operator field, item 1 */
+    lsrs r1, r0, #24
+    cmp r1, #0x80                 /* Borrowed UCS2 TextID */
+    beq check_name
+    cmp r1, #0x88                 /* Owned UCS2 TextID */
+    bne create_name
+check_name:
+    lsls r0, r0, #8
+    lsrs r0, r0, #8
+    ldr r3, =0x44eeb4ad           /* TextID descriptor lookup */
+    blx r3
+    cmp r0, #0
+    beq create_name
+    ldrh r1, [r0, #8]
+    cmp r1, #6
+    bne create_name
+    ldr r0, [r0, #4]
+    cmp r0, #0
+    beq create_name
+    ldr r1, [r0]
+    ldr r2, =0x00680070           /* p h */
+    cmp r1, r2
+    bne create_name
+    ldr r1, [r0, #4]
+    ldr r2, =0x006e0030           /* 0 n */
+    cmp r1, r2
+    bne create_name
+    ldr r1, [r0, #8]
+    ldr r2, =0x00780069           /* i x */
+    cmp r1, r2
+    beq clear_status
+create_name:
+    adr r0, operator_text
+    movs r1, #0                   /* ENC_UCS2 */
+    movs r2, #6
+    ldr r3, =0x44eebddd           /* TextID_Create */
+    blx r3
+    ldr r1, =0x6fffffff           /* EMPTY_TEXTID / allocation failure */
+    cmp r0, r1
+    beq original_redraw
+    movs r2, r0
+    movs r0, r5
+    movs r1, #1
+    movs r3, #0                   /* Already inside a redraw: no invalidation */
+    ldr r7, =0x44e7fc85           /* Layout_SetItemText, consumes the TextID */
+    blx r7
+clear_status:
+    ldr r2, [r6, #28]             /* Searching / inactive SIM fallback, item 2 */
+    ldr r1, =0x6fffffff
+    cmp r2, r1
+    beq original_redraw
+    movs r2, r1
+    movs r0, r5
+    movs r1, #2
+    movs r3, #0
+    ldr r7, =0x44e7fc85
+    blx r7
+original_redraw:
+    pop {r0, r1, r2, r4, r5, r6, r7}
+    pop {r3}
+    mov lr, r3
+    /* Reproduce the eight replaced bytes, including the condition flags. */
+    push {r1, r4, r5, r6, lr}
+    adds r4, r0, #0
+    adds r6, r2, #0
+    cmp r0, #0
+    ldr r3, =0x44e98c01
+    bx r3
+.balign 4
+operator_text:
+    .hword 0x0070, 0x0068, 0x0030, 0x006e, 0x0069, 0x0078, 0
+.balign 4
+.ltorg
diff --git a/hw/arm/db2010-operator-name.c b/hw/arm/db2010-operator-name.c
new file mode 100644
index 0000000000000000000000000000000000000000..31428d00be00e6914da427075a2ab02aa220f49f
--- /dev/null
+++ b/hw/arm/db2010-operator-name.c
@@ -0,0 +1,65 @@
+/* Revision-checked native K750 standby customization.
+ * Firmware input files and other handset renderers are never rewritten.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "db2010-internal.h"
+#include "db2010-operator-name.inc"
+
+#define OPERATOR_HELPER_ADDRESS 0x44018000u
+#define OPERATOR_REDRAW_ADDRESS 0x44e98bf8u
+
+bool db2010_apply_operator_brand(DB2010MachineState *s)
+{
+    /* R1DB001 native apps authenticate MAIN before mapping it. Keep the
+     * guarded research runner and unrelated firmware revisions intact. */
+    if (s->research_guards || !s->has_nor || !s->has_simif) { return false; }
+    DB2010Region *r = find_region(s, OPERATOR_HELPER_ADDRESS,
+                                OPERATOR_REDRAW_ADDRESS - OPERATOR_HELPER_ADDRESS + 24);
+    if (!r || !r->readonly || r->base != 0x44000000 || r->size != 0x2000000) {
+        return false;
+    }
+    uint8_t *bytes = memory_region_get_ram_ptr(r->mr);
+    static const struct {
+        uint32_t address;
+        uint8_t bytes[12];
+    } witnesses[] = {
+        {0x44eeb4ac, {0x11,0xb5,0x04,0x1c,0x09,0x48,0x00,0x68,0x00,0x90,0x20,0x0a}},
+        {0x44eebddc, {0xf4,0xb5,0x04,0x1c,0x4f,0x48,0x05,0x1c,0x00,0x2c,0x83,0xb0}},
+        {0x44e7fc84, {0xf2,0xb5,0x82,0xb0,0x04,0x1c,0x15,0x1c,0x1e,0x1c,0x00,0x27}},
+        {0x44e98c00, {0x05,0xd1,0xff,0x21,0x89,0x1d,0x28,0x48,0x20,0xf4,0x1e,0xf9}},
+    };
+    for (unsigned i = 0; i < ARRAY_SIZE(witnesses); i++) {
+        unsigned offset = witnesses[i].address - r->base;
+        for (unsigned j = 0; j < sizeof(witnesses[i].bytes); j++) {
+            if (r->known[offset + j] != 1 ||
+                bytes[offset + j] != witnesses[i].bytes[j]) { return false; }
+        }
+    }
+    static const uint8_t original[] = {0x72,0xb5,0x04,0x1c,0x16,0x1c,0x00,0x28};
+    /* ldr r3,[pc,#0]; bx r3; .word 0x44018001 */
+    static const uint8_t replacement[] = {0x00,0x4b,0x18,0x47,0x01,0x80,0x01,0x44};
+    unsigned redraw = OPERATOR_REDRAW_ADDRESS - r->base;
+    bool installed = !memcmp(bytes + redraw, replacement, sizeof(replacement));
+    if (!installed && memcmp(bytes + redraw, original, sizeof(original))) { return false; }
+    for (unsigned i = 0; i < sizeof(original); i++) {
+        if (r->known[redraw + i] != 1) { return false; }
+    }
+    unsigned helper = OPERATOR_HELPER_ADDRESS - r->base;
+    /* The helper occupies an unseeded NOR prefix before MAIN's first record
+     * at 0x44020000. A restored copy must match this exact published helper. */
+    for (unsigned i = 0; i < sizeof(operator_redraw_code); i++) {
+        if (r->known[helper + i] == 1) {
+            if (!installed || bytes[helper + i] != operator_redraw_code[i]) { return false; }
+        } else if (bytes[helper + i] != 0 && bytes[helper + i] != 0xff) {
+            return false;
+        }
+    }
+    memcpy(bytes + helper, operator_redraw_code, sizeof(operator_redraw_code));
+    memset(r->known + helper, 1, sizeof(operator_redraw_code));
+    memcpy(bytes + redraw, replacement, sizeof(replacement));
+    /* Also invalidate translations when resuming an older native checkpoint,
+     * including a NOR device temporarily outside ROMD array mode. */
+    memory_region_flush_rom_device(r->mr, helper, sizeof(operator_redraw_code));
+    memory_region_flush_rom_device(r->mr, redraw, sizeof(replacement));
+    return true;
+}
