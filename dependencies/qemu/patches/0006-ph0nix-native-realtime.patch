+static bool legacy_icount_restore;
+
+static void legacy_icount_timer(void *opaque)
+{
+    /* Compatibility storage only; restored icount timers are cancelled. */
+}
+
+void cpu_timers_prepare_legacy_icount_restore(unsigned shift)
+{
+    assert(!icount_enabled() && shift <= 10);
+    legacy_icount_restore = true;
+    timers_state.icount_time_shift = shift;
+    /* Old saves can contain these timer pointers even though the new engine
+     * has instruction counting disabled. Allocate their migration storage
+     * before loading; a NULL VMSTATE_TIMER_PTR cannot accept that subsection. */
+    timers_state.icount_warp_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL_RT,
+                                                 legacy_icount_timer, NULL);
+    timers_state.icount_rt_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL_RT,
+                                               legacy_icount_timer, NULL);
+    timers_state.icount_vm_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                               legacy_icount_timer, NULL);
+}
+
+static int legacy_icount_post_load(void *opaque, int version_id)
+{
+    TimersState *s = opaque;
+    if (!legacy_icount_restore || icount_enabled()) { return 0; }
+    if (s->icount_time_shift < 0 || s->icount_time_shift > 10 || s->qemu_icount < 0) {
+        return -EINVAL;
+    }
+    __int128 virtual_ns = (__int128)s->qemu_icount_bias +
+                          ((__int128)s->qemu_icount << s->icount_time_shift);
+    if (virtual_ns < 0 || virtual_ns > INT64_MAX) { return -EINVAL; }
+    /* Preserve the saved guest timestamp before any board clock phase is
+     * restored. CPU execution now advances the normal paused/resumed clock;
+     * changing the rate must never move guest time backwards. */
+    seqlock_write_lock(&s->vm_clock_seqlock, &s->vm_clock_lock);
+    qatomic_set(&s->cpu_clock_offset, (int64_t)virtual_ns);
+    seqlock_write_unlock(&s->vm_clock_seqlock, &s->vm_clock_lock);
+    timer_del(s->icount_warp_timer);
+    timer_del(s->icount_rt_timer);
+    timer_del(s->icount_vm_timer);
+    s->vm_clock_warp_start = -1;
+    return 0;
+}
+
 /*
  * Subsection for warp timer migration is optional, because may not be created
  */
@@ -204,6 +250,7 @@
     .version_id = 1,
     .minimum_version_id = 1,
     .needed = icount_state_needed,
+    .post_load = legacy_icount_post_load,
